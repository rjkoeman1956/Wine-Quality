      </operator>
      <operator activated="true" class="python_scripting:execute_python" compatibility="11.0.006" expanded="true" height="103" name="Execute Python" width="90" x="715" y="34">
        <parameter key="script" value="import shap&#10;import pandas as pd&#10;from sklearn.ensemble import RandomForestClassifier&#10;&#10;# Omdat er 1 kabel is aangesloten, gebruiken we exact 1 argument: data&#10;def rm_main(data):&#10;    # 1. Bepaal de labelkolom (vervang 'Survived' door 'class' als je de Wine-set gebruikt)&#10;    target_column = 'Survived' &#10;    &#10;    if target_column not in data.columns:&#10;        # Automatische fallback naar 'class' voor de Wine-dataset&#10;        target_column = 'class' if 'class' in data.columns else data.columns[0]&#10;&#10;    # 2. Scheid de features van de voorspelde labels&#10;    columns_to_drop = [target_column, f'prediction({target_column})']&#10;    columns_to_drop = [col for col in columns_to_drop if col in data.columns]&#10;    &#10;    X = data.drop(columns=columns_to_drop)&#10;    &#10;    # Converteer het label naar integers om 'Unknown label type' te voorkomen&#10;    # Probeer eerst numeriek te maken, anders categorisch via factorize&#10;    try:&#10;        y = data[target_column].astype(int)&#10;    except ValueError:&#10;        y = pd.factorize(data[target_column])[0]&#10;    &#10;    # Tekstkolommen omzetten naar dummies&#10;    X_encoded = pd.get_dummies(X, drop_first=True)&#10;    &#10;    # 3. Train het schaduwmodel om de SHAP-waarden te kunnen berekenen&#10;    shadow_model = RandomForestClassifier(n_estimators=50, random_state=42)&#10;    shadow_model.fit(X_encoded, y)&#10;    &#10;    # 4. Bereken SHAP (met additiviteitscontrole uitgeschakeld)&#10;    explainer = shap.TreeExplainer(shadow_model)&#10;    shap_values = explainer.shap_values(X_encoded, check_additivity=False)&#10;    &#10;    # 5. SHAP-matrix netjes uitlijnen voor de tabel&#10;    if isinstance(shap_values, list):&#10;        shap_matrix = shap_values&#10;    else:&#10;        shap_matrix = shap_values.values if hasattr(shap_values, 'values') else shap_values&#10;        if len(shap_matrix.shape) == 3: # Multiclass backup (zoals Wine)&#10;            shap_matrix = shap_matrix[:, :, 0]&#10;            &#10;    shap_df = pd.DataFrame(shap_matrix, columns=[f&quot;shap_{col}&quot; for col in X_encoded.columns])&#10;    &#10;    # 6. Plak de SHAP-waarden vast aan de originele dataset&#10;    return pd.concat([data.reset_index(drop=True), shap_df], axis=1)"/>
        <parameter key="notebook_cell_tag_filter" value=""/>
        <parameter key="use_default_python" value="true"/>
        <parameter key="package_manager" value="conda (anaconda)"/>
        <parameter key="use_macros" value="false"/>
      </operator>
