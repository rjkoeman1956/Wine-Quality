      <operator activated="true" class="python_scripting:execute_python" compatibility="11.0.006" expanded="true" height="103" name="Execute Python" width="90" x="648" y="289">
        <parameter key="script" value="import shap&#10;import pandas as pd&#10;from sklearn.ensemble import RandomForestClassifier&#10;&#10;def rm_main(data):&#10;    # 1. Scheid de features van de voorspelde labels&#10;    columns_to_drop = ['quality', 'prediction(quality)']&#10;    columns_to_drop = [col for col in columns_to_drop if col in data.columns]&#10;    &#10;    X = data.drop(columns=columns_to_drop)&#10;    y = data['quality']&#10;    &#10;    # Text naar dummies converteren&#10;    X_encoded = pd.get_dummies(X, drop_first=True)&#10;    &#10;    # Train het schaduwmodel&#10;    shadow_model = RandomForestClassifier(n_estimators=50, random_state=42)&#10;    shadow_model.fit(X_encoded, y)&#10;    &#10;    # 2. Initialiseer de explainer&#10;    explainer = shap.TreeExplainer(shadow_model)&#10;    &#10;    # 3. Bereken SHAP en DEACTIVEER de additiviteitscontrole (check_additivity=False)&#10;    # Dit voorkomt dat het script crasht op floating-point / vorm-verschillen.&#10;    shap_values = explainer.shap_values(X_encoded, check_additivity=False)&#10;    &#10;    # 4. Converteer de SHAP-matrix naar een DataFrame&#10;    # Bij classificatie geeft shap_values een lijst terug per klasse (0 of 1). &#10;    # We pakken index 1 (de SHAP-waarden voor 'Wel overleefd')&#10;    if isinstance(shap_values, list):&#10;        shap_matrix = shap_values[1]&#10;    else:&#10;        # Afhankelijk van de SHAP-versie kan het een 3D-array of object zijn&#10;        shap_matrix = shap_values.values if hasattr(shap_values, 'values') else shap_values&#10;        if len(shap_matrix.shape) == 3: # Indien [samples, features, classes]&#10;            shap_matrix = shap_matrix[:, :, 1]&#10;            &#10;    shap_df = pd.DataFrame(shap_matrix, columns=[f&quot;shap_{col}&quot; for col in X_encoded.columns])&#10;    &#10;    # 5. Plak de SHAP-waarden vast aan de originele dataset&#10;    return pd.concat([data.reset_index(drop=True), shap_df], axis=1)"/>
        <parameter key="notebook_cell_tag_filter" value=""/>
        <parameter key="use_default_python" value="true"/>
        <parameter key="package_manager" value="conda (anaconda)"/>
