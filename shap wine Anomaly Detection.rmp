      <operator activated="true" class="multiply" compatibility="12.1.001" expanded="true" height="103" name="Multiply" width="90" x="514" y="493"/>
      <operator activated="true" class="python_scripting:execute_python" compatibility="11.0.006" expanded="true" height="103" name="Execute Python" width="90" x="715" y="493">
        <parameter key="script" value="import shap&#10;import pandas as pd&#10;from sklearn.ensemble import RandomForestClassifier&#10;&#10;def rm_main(data):&#10;    # 1. Bepaal de clusterkolom (RapidMiner noemt deze standaard 'cluster')&#10;    # Mocht je de kolom handmatig een andere naam hebben gegeven, pas dit hier aan.&#10;    target_column = 'cluster' &#10;    &#10;    if target_column not in data.columns:&#10;        # Zoek naar kolommen waar het woord 'cluster' in voorkomt als fallback&#10;        found_cols = [col for col in data.columns if 'cluster' in col.lower()]&#10;        if found_cols:&#10;            target_column = found_cols[0]&#10;        else:&#10;            raise ValueError(f&quot;Geen clusterkolom gevonden. Beschikbare kolommen: {list(data.columns)}&quot;)&#10;&#10;    # 2. Scheid de features van de cluster-labels&#10;    # We verwijderen de clusterkolom en eventuele handmatige labels/voorspellingen&#10;    columns_to_drop = [target_column]&#10;    # Verwijder ook andere id- of labelkolommen als die er zijn (optioneel)&#10;    columns_to_drop = [col for col in columns_to_drop if col in data.columns]&#10;    &#10;    X = data.drop(columns=columns_to_drop)&#10;    &#10;    # Zet de clusternamen (bijv. 'cluster_0', 'cluster_1') om naar getallen (0, 1, 2...)&#10;    # zodat de scikit-learn RandomForest ermee kan rekenen&#10;    y, cluster_mapping = pd.factorize(data[target_column])&#10;    &#10;    # Tekstkolommen/categorische variabelen automatisch omzetten naar dummies&#10;    X_encoded = pd.get_dummies(X, drop_first=True)&#10;    &#10;    # 3. Train het schaduwmodel dat leert de clusters te voorspellen&#10;    shadow_model = RandomForestClassifier(n_estimators=50, random_state=42)&#10;    shadow_model.fit(X_encoded, y)&#10;    &#10;    # 4. Bereken SHAP (met additiviteitscontrole uitgeschakeld)&#10;    explainer = shap.TreeExplainer(shadow_model)&#10;    shap_values = explainer.shap_values(X_encoded, check_additivity=False)&#10;    &#10;    # 5. SHAP-waarden uitlijnen voor multiclass clustering&#10;    # Bij clustering heb je bijna altijd meerdere klassen (Cluster 0, Cluster 1, etc.).&#10;    # We pakken hier standaard de SHAP-waarden voor het EERSTE cluster (index 0).&#10;    if isinstance(shap_values, list):&#10;        shap_matrix = shap_values[0] &#10;    else:&#10;        shap_matrix = shap_values.values if hasattr(shap_values, 'values') else shap_values&#10;        if len(shap_matrix.shape) == 3: # Vorm: [samples, features, clusters]&#10;            shap_matrix = shap_matrix[:, :, 0] # Index 0 = Cluster_0&#10;            &#10;    # Maak een DataFrame van de SHAP-waarden met een herkenbare prefix&#10;    # We voegen de naam van het cluster toe aan de kolomnaam ter verduidelijking&#10;    cluster_name = cluster_mapping[0] if len(cluster_mapping) &gt; 0 else &quot;0&quot;&#10;    shap_df = pd.DataFrame(shap_matrix, columns=[f&quot;shap_{cluster_name}_{col}&quot; for col in X_encoded.columns])&#10;    &#10;    # 6. Plak de SHAP-waarden weer aan je originele clustered dataset vast&#10;    return pd.concat([data.reset_index(drop=True), shap_df], axis=1)"/>
        <parameter key="notebook_cell_tag_filter" value=""/>
